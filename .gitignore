# The verification tools import a shared module (tools_swiftconst.py) now,
# so Python leaves bytecode caches next to them. Nothing here belongs in
# the repository.
__pycache__/
*.pyc

# macOS/iPadOS file-manager litter, which Swift Playgrounds sync can drop
# into the project folder.
.DS_Store

# Generated by tools_baseball_field_preview.py — regenerate it rather than
# tracking it, so the picture can never disagree with the script.
baseball_field_preview.svg
