# The verification tools import a shared module (tools_swiftconst.py) now,
# so Python leaves bytecode caches next to them. Nothing here belongs in
# the repository.
__pycache__/
*.pyc

# macOS/iPadOS file-manager litter, which Swift Playgrounds sync can drop
# into the project folder.
.DS_Store

# Generated by tools_baseball_field_preview.py — regenerate it rather than
# tracking it, so the picture can never disagree with the script.
baseball_field_*.svg

# Generated by tools_motif_preview.py — the same rule as the field SVG:
# regenerate and look at it, rather than tracking a picture that can
# drift from the script that draws it.
motif-*.png

# Generated by tools_arena_preview.py and tools_scoreboard_preview.py —
# regenerate and look at them rather than tracking pictures that can
# drift from the scripts that draw them.
royalur-board.png
scoreboard-*.png
surfaces.png
